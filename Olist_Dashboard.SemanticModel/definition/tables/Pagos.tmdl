	column 'Monto Pago'
		dataType: decimal
		formatString: R$ #,0.00
		lineageTag: bfde5e3d-d414-4711-857f-10056d6a1325
		summarizeBy: none
		sourceColumn: payment_value

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"es-AR"}

	column 'Método Pago' = SWITCH( Pagos[Tipo Pago (origen)], "credit_card", "Tarjeta de Crédito", "debit_card", "Tarjeta de Débito", "voucher", "Voucher", "boleto", "Boleto", "Otros" )
		lineageTag: 5c824aa6-5db1-4c4a-98ea-91cfa99291d4

	partition Pagos = m
		mode: import
		source =
				// Pagos: una fila por pago de pedido (100.396). Método de pago, cuotas y monto.
				let
				    Origen = Olist_Base,
				    Columnas = Table.SelectColumns(
				        Origen,
				        {"order_id", "payment_sequential", "payment_type", "payment_installments", "payment_value"}
				    ),
				    Unicos = Table.Distinct(Columnas, {"order_id", "payment_sequential"})
				in
				    Unicos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

