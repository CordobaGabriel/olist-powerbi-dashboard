	measure Ticket_Promedio_Seller = ```
			
			VAR VentasTotales = SUM('df_nuevas_columnas'[price]) 
			VAR PedidosTotales = DISTINCTCOUNT('df_nuevas_columnas'[order_id])
			RETURN 
			DIVIDE(VentasTotales, PedidosTotales, 0) 
			```
		lineageTag: b5ecdaca-b17b-43e0-bedd-29339564bb26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ingresos_Seller = ```
			
