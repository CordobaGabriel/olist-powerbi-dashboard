	/// Pedidos únicos. Respeta todos los filtros y slicers.
	measure Order_Count_macro = DISTINCTCOUNT('df_nuevas_columnas'[order_id])
		formatString: #,0
		lineageTag: 97949244-e981-4fa0-b652-c16f238a0d9e

	/// Ventas (misma lógica que Total Ventas). Respeta todos los filtros y slicers.
	measure Total_Payment_Value_Macro = [Total Ventas]
		formatString: R$ #,0
		lineageTag: b0705570-9bb2-4517-9680-28005850b479

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Participación en las ventas del total seleccionado con los slicers. Devuelve un número (no texto).
	measure Total_Pay_Value_Pct_Macro =
			DIVIDE(
			    [Total Ventas],
			    CALCULATE([Total Ventas], ALLSELECTED('df_nuevas_columnas')),
			    0
			)
		formatString: 0.00%
		lineageTag: 12533b06-ef9e-45d6-ba2b-d1c08d0d40b0

	measure Porcentaje_Pedidos_Con_Comentarios = ```
			
			VAR TotalPedidos = COUNT('df_nuevas_columnas'[order_id])
			VAR PedidosConComentarios = CALCULATE(
			    COUNT('df_nuevas_columnas'[order_id]), 
			    NOT(ISBLANK('df_nuevas_columnas'[review_score_entero])) 
			)
			
			RETURN 
			DIVIDE(PedidosConComentarios, TotalPedidos, 0)
			```
		lineageTag: cf93db31-1da3-4f5a-9c55-b1195525a334

		annotation PBI_FormatHint = {"isGeneralNumber":true}

