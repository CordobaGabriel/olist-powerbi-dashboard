	measure Sellers_Nuevos_Mes = ```
			
			CALCULATE(
			    DISTINCTCOUNT('df_nuevas_columnas'[seller_id]),
			    FILTER(
			        'df_nuevas_columnas',
			        'df_nuevas_columnas'[order_purchase_timestamp] = 
			        CALCULATE(MIN('df_nuevas_columnas'[order_purchase_timestamp]), 
			                 ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[seller_id])
			        )
			    )
			)
			
			```
		formatString: 0
		lineageTag: 716b5e57-8156-47ea-85e8-27665cd31a75

	measure Ticket_Promedio_Por_Seller = ```
			
			VAR VentasPorSeller = CALCULATE(SUM('df_nuevas_columnas'[price]), ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[seller_id]))
			VAR PedidosPorSeller = CALCULATE(DISTINCTCOUNT('df_nuevas_columnas'[order_id]), ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[seller_id]))
			RETURN 
			DIVIDE(VentasPorSeller, PedidosPorSeller, 0)
			```
		lineageTag: 57e1e0f4-2673-4b8c-a7bb-10c02cfd3243

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Pedidos que tienen reseña.
	measure Total_Reseñas =
			CALCULATE(
			    DISTINCTCOUNT('df_nuevas_columnas'[order_id]),
			    NOT ISBLANK('df_nuevas_columnas'[review_score_entero])
			)
		formatString: #,0
