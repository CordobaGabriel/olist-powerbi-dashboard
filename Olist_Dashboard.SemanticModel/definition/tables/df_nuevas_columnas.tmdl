	column 'Cliente Recurrente' =
			
			VAR PedidosCliente = CALCULATE(COUNT([order_id]), ALLEXCEPT( 'df_nuevas_columnas', 'df_nuevas_columnas'[customer_unique_id] ))
			RETURN IF(PedidosCliente > 1, "Recurrente", "Nuevo")
		lineageTag: 72f9036d-3b50-4f24-873b-b631473c7c81
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Estado Completo' = ```
			
			SWITCH(
			    'df_nuevas_columnas'[customer_state],
			    "AC", "Acre",
			    "AL", "Alagoas",
			    "AP", "Amapá",
			    "AM", "Amazonas",
			    "BA", "Bahia",
			    "CE", "Ceará",
			    "DF", "Distrito Federal",
			    "ES", "Espírito Santo",
			    "GO", "Goiás",
			    "MA", "Maranhão",
			    "MT", "Mato Grosso",
			    "MS", "Mato Grosso do Sul",
			    "MG", "Minas Gerais",
			    "PA", "Pará",
			    "PB", "Paraíba",
			    "PR", "Paraná",
			    "PE", "Pernambuco",
			    "PI", "Piauí",
			    "RJ", "Río de Janeiro",
			    "RN", "Río Grande do Norte",
			    "RS", "Río Grande do Sul",
			    "RO", "Rondônia",
			    "RR", "Roraima",
			    "SC", "Santa Catarina",
			    "SP", "São Paulo",
			    "SE", "Sergipe",
			    "TO", "Tocantins",
			    "Desconocido"  -- Para manejar valores nulos o erróneos
			)
			
			```
		lineageTag: cf00b1e6-5a2b-4fed-80a5-cebfdbb8fb25
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Costo_Envio_Categoria = ```
			
			VAR Q1 = CALCULATE(PERCENTILE.INC('df_nuevas_columnas'[freight_value], 0.25), ALL('df_nuevas_columnas'))
			VAR Q3 = CALCULATE(PERCENTILE.INC('df_nuevas_columnas'[freight_value], 0.75), ALL('df_nuevas_columnas'))
			VAR Costo = 'df_nuevas_columnas'[freight_value]
			RETURN 
			    SWITCH(
			        TRUE(),
			        Costo <= Q1, "Envío barato",
			        Costo > Q1 && Costo <= Q3, "Costo medio",
			        Costo > Q3, "Envío caro",
			        "Sin datos"
			    )
			
			```
		lineageTag: cb008239-2391-4b8e-8318-1d9a1fb85797
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Año-Mes = FORMAT('df_nuevas_columnas'[order_purchase_timestamp], "YYYY-MM")
		lineageTag: d83b3e8a-9926-40c5-98e3-1021a9c3c48c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Region =
			SWITCH(
			    TRUE(),
			    'df_nuevas_columnas'[customer_state] IN {"AC", "AP", "AM", "PA", "RO", "RR", "TO"}, "Norte",
			    'df_nuevas_columnas'[customer_state] IN {"AL", "BA", "CE", "MA", "PB", "PE", "PI", "RN", "SE"}, "Nordeste",
			    'df_nuevas_columnas'[customer_state] IN {"DF", "GO", "MT", "MS"}, "Centro-Oeste",
			    'df_nuevas_columnas'[customer_state] IN {"ES", "MG", "RJ", "SP"}, "Sudeste",
			    'df_nuevas_columnas'[customer_state] IN {"PR", "RS", "SC"}, "Sur",
			    "Desconocido" )
		lineageTag: 4bba01d2-5633-4b34-b794-9d4c72dd8fad
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column review_score_entero = ```
			
			VAR score = TRIM('df_nuevas_columnas'[review_score])  -- Elimina espacios en blanco
			RETURN 
			    IF(
			        score = "" || score = BLANK(),  -- Verifica si la celda está vacía
			        BLANK(),  -- Si está vacía, deja el valor en BLANK()
			        INT(VALUE(score))  -- Si tiene un número, lo convierte a entero
			    )
			```
		formatString: 0
		lineageTag: c9b526ff-72b3-4b86-bc68-9ee2efa6e4ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Metodo Pago Filtro' =
			
			IF(
			    'df_nuevas_columnas'[payment_type] IN {"credit_card", "voucher", "debit_card", "boleto"},
			    'df_nuevas_columnas'[payment_type],
			    "Otros"
			)
		lineageTag: 9d399a9a-7c73-4741-86c0-5b79002ce183
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Categoría_Precio =
			
			SWITCH(
			    TRUE(),
			    'df_nuevas_columnas'[price] < 50, "Económico",
			    'df_nuevas_columnas'[price] >= 50 && 'df_nuevas_columnas'[price] < 200, "Medio",
			    'df_nuevas_columnas'[price] >= 200, "Premium"
			)
		lineageTag: f0f51012-23cc-493f-821e-6e2e63523875
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Metodo_Pago_Filtro_Limpio =
			
			SWITCH(
			    'df_nuevas_columnas'[payment_type],
			    "credit_card", "Tarjeta Credito",
			    "debit_card", "Tarjeta Debito",
			    "voucher", "Voucher",
			    "boleto", "Boleta",
			    "Otros"
			)
		lineageTag: 3965ab05-6250-4db0-9b14-24d947ff8cc1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Macro_Category_Calculo =
			
			SWITCH(
			    TRUE(),
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Ropa Femenina", "Ropa Masculina", "Ropa Infantil", "Calzado de Moda",
			        "Moda Deportiva", "Ropa Interior y Moda de Playa", "Bolsos y Accesorios de Moda",
			        "Relojes y Regalos", "Maletas y Accesorios"
			    }, "Moda",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Muebles para Living", "Muebles para Dormitorio", "Muebles de Decoración",
			        "Muebles de Oficina", "Muebles para el Hogar", "Artículos para el Hogar",
			        "Hogar y Confort", "Cama, Mesa y Baño", "Flores", "Climatización",
			        "Sillones, Colchones y Tapicería"
			    }, "Hogar y Decoración",
			    'df_nuevas_columnas'[product_category_name_es] = "Automotriz", "Automotriz",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Materiales de Construcción", "Herramientas de Construcción",
			        "Herramientas de Seguridad para Construcción", "Herramientas para Construcción y Jardinería",
			        "Herramientas para Jardín", "Herramientas de Iluminación para Construcción"
			    }, "Construcción",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Computadoras y PCs", "Accesorios de Informática", "Tablets, Impresión e Imagen",
			        "Consolas y Videojuegos", "Electrónica", "Telefonía", "Telefonía Fija", "Audio"
			    }, "Tecnología",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Belleza y Salud", "Perfumería"
			    }, "Belleza y Cuidado Personal",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Electrodomésticos", "Pequeños Electrodomésticos", "Pequeños Electrodomésticos de Cocina"
			    }, "Electrodomésticos",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Alimentos", "Alimentos y Bebidas", "Bebidas", "Gastronomía", "Seguridad y Servicios",
			        "CDs, DVDs y Música", "Música", "Libros de Interés General", "Libros Técnicos",
			        "Libros Importados", "Instrumentos Musicales", "Cine y Fotografía", "DVDs y Blu-ray",
			        "Marketplace", "Productos Innovadores", "Artículos de Navidad", "Artículos para Fiestas",
			        "Deportes y Ocio", "Juguetes", "Artes y Artesanías", "Señalización y Seguridad",
			        "Industria, Comercio y Negocios", "Agroindustria y Comercio", "Papelería", "Otros"
			    }, "Mercado",
			    'df_nuevas_columnas'[product_category_name_es] IN {
			        "Bebés", "Pañales e Higiene"
			    }, "Cuidado Infantil",
			    'df_nuevas_columnas'[product_category_name_es] = "Tienda de Mascotas", "Mascotas",
			    "Mercado"  // Valor por defecto si no hay coincidencia
			)
		lineageTag: fdf210c6-1696-4c64-99e0-3bbe2d1d96bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Late_Delivery_Label_Limpio = ```
			
			SWITCH(
			    'df_nuevas_columnas'[late_delivery_label], 
			    "on_time", "A Tiempo",
			    "late_delivery", "Tardío")
			```
