	measure Calificacion_Promedio_Tipo_Entrega = ```
			
			CALCULATE(
			    AVERAGE('df_nuevas_columnas'[review_score]), 
			    ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[on_time])
			)
			```
		formatString: 0
