table df_nuevas_columnas
	lineageTag: 54862383-fd3c-4b3c-9fb8-991c4cdb5452

	/// Suma de pagos contando cada pago (pedido + payment_sequential) una sola vez, aunque el pedido tenga varios ítems.
	measure 'Total Ventas' =
			SUMX(
			    SUMMARIZE(
			        'df_nuevas_columnas',
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[payment_sequential],
			        'df_nuevas_columnas'[payment_value]
			    ),
			    'df_nuevas_columnas'[payment_value]
			)
		formatString: R$ #,0
		lineageTag: 1b4c13b5-837f-457a-9f57-f22936f4b96c

	/// Costo de envío total, contando cada ítem de pedido una sola vez.
	measure Freight_Sum =
			SUMX(
			    SUMMARIZE(
			        'df_nuevas_columnas',
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[order_item_id],
			        'df_nuevas_columnas'[freight_value]
			    ),
			    'df_nuevas_columnas'[freight_value]
			)
		formatString: R$ #,0
		lineageTag: 56f1a5b1-e984-496c-af21-ab0a2eb927bb

	/// Ventas promedio por pedido.
	measure 'Ticket Promedio' = DIVIDE( [Total Ventas], [Total Pedidos] )
		formatString: R$ #,0.00
		lineageTag: b6f55380-4a31-457e-b938-00247cbbe5ec

	measure 'Total Pedidos' = DISTINCTCOUNT([order_id])
		formatString: 0
		lineageTag: 19e2689b-fdf2-4b18-bdfe-eb1955c1f7ae

	measure Order_Count = ```
			
			CALCULATE(
			    COUNT('df_nuevas_columnas'[order_id]),
			    ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[product_category_name_es])
			)
			
			```
		formatString: 0
		lineageTag: 559b4fca-2816-4cb2-b8c7-3ee2b60c4ff2

	measure Total_Payment_Value = ```
			
			CALCULATE(
			    SUM('df_nuevas_columnas'[payment_value]),
			    ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[product_category_name_es])
			)
			
			```
		formatString: 0
		lineageTag: b57370f4-c063-4a27-8bd9-29439e765c0f

	measure Total_Pay_Value_Pct = ```
			
			VAR Total_Payment = CALCULATE(SUM('df_nuevas_columnas'[payment_value]), ALL('df_nuevas_columnas'))
			RETURN 
			FORMAT(DIVIDE([Total_Payment_Value], Total_Payment, 0) * 100, "0.00") & "%"
			
			```
		lineageTag: 4434b4c5-c555-466d-ace6-7174b15d9386

	/// Pedidos entregados después del día estimado / pedidos entregados. Compara por día (yyyy-mm-dd), a nivel pedido.
	measure '% Pedidos con Retraso' =
			VAR Pedidos =
			    SUMMARIZE(
			        FILTER(
			            'df_nuevas_columnas',
			            'df_nuevas_columnas'[order_delivered_customer_date] <> ""
			                && 'df_nuevas_columnas'[order_estimated_delivery_date] <> ""
			        ),
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[order_delivered_customer_date],
			        'df_nuevas_columnas'[order_estimated_delivery_date]
			    )
			VAR PedidosTarde =
			    COUNTROWS(
			        FILTER(
			            Pedidos,
			            LEFT('df_nuevas_columnas'[order_delivered_customer_date], 10)
			                > LEFT('df_nuevas_columnas'[order_estimated_delivery_date], 10)
			        )
			    )
			RETURN
			    DIVIDE(PedidosTarde, COUNTROWS(Pedidos), 0)
		formatString: 0.0%
		lineageTag: ca8d2d8e-4b49-4043-9bc5-f1c77b63dfef

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo Promedio Envío' = ```
			AVERAGE('df_nuevas_columnas'[freight_value])
			
			```
		lineageTag: f07615a5-3b0f-4814-a8ea-3b56a514b662

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Días promedio entre compra y entrega, por pedido.
	measure 'Tiempo Promedio Entrega' =
			VAR Pedidos =
			    SUMMARIZE(
			        FILTER('df_nuevas_columnas', 'df_nuevas_columnas'[order_delivered_customer_date] <> ""),
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[order_purchase_timestamp],
			        'df_nuevas_columnas'[order_delivered_customer_date]
			    )
			RETURN
			    AVERAGEX(
			        Pedidos,
			        VAR s = 'df_nuevas_columnas'[order_delivered_customer_date]
			        RETURN
			            DATEDIFF(
			                'df_nuevas_columnas'[order_purchase_timestamp],
			                DATE(VALUE(LEFT(s, 4)), VALUE(MID(s, 6, 2)), VALUE(MID(s, 9, 2))),
			                DAY
			            )
			    )
		formatString: 0.0
		lineageTag: 60e7810a-4174-4bf8-aef0-5d742e4e1657

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pedidos_por_Categoria_Costo = ```
			
			COUNTROWS('df_nuevas_columnas')
			
			```
		formatString: 0
		lineageTag: 9ef16a6c-63d3-4684-8932-eb0a43c01028

	/// Días promedio entre compra y fecha estimada de entrega, por pedido.
	measure 'Tiempo Estimado Entrega' =
			VAR Pedidos =
			    SUMMARIZE(
			        FILTER('df_nuevas_columnas', 'df_nuevas_columnas'[order_estimated_delivery_date] <> ""),
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[order_purchase_timestamp],
			        'df_nuevas_columnas'[order_estimated_delivery_date]
			    )
			RETURN
			    AVERAGEX(
			        Pedidos,
			        VAR s = 'df_nuevas_columnas'[order_estimated_delivery_date]
			        RETURN
			            DATEDIFF(
			                'df_nuevas_columnas'[order_purchase_timestamp],
			                DATE(VALUE(LEFT(s, 4)), VALUE(MID(s, 6, 2)), VALUE(MID(s, 9, 2))),
			                DAY
			            )
			    )
		formatString: 0.0
		lineageTag: 5d0150da-d729-4725-9f67-e05c486a1819

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Order_Count_Pct = ```
			
			DIVIDE(
			    COUNT('df_nuevas_columnas'[order_id]), 
			    CALCULATE(COUNT('df_nuevas_columnas'[order_id]), ALL('df_nuevas_columnas')),
			    0
			)
			
			```
		lineageTag: 446c38ce-d122-41ad-9d5f-583bb3fbc333

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Reseñas con puntaje 4 o 5 / total de reseñas. Cada reseña cuenta una vez por pedido.
	measure '% Reseñas Positivas' =
			VAR Resenas =
			    SUMMARIZE(
			        FILTER('df_nuevas_columnas', NOT ISBLANK('df_nuevas_columnas'[review_score_entero])),
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[review_score_entero]
			    )
			RETURN
			    DIVIDE(
			        COUNTROWS(FILTER(Resenas, 'df_nuevas_columnas'[review_score_entero] >= 4)),
			        COUNTROWS(Resenas),
			        0
			    )
		formatString: 0.0%
		lineageTag: 9f3551ec-c119-4b61-9947-421576b79ab0

	/// Puntaje promedio de reseñas (1 a 5), una por pedido.
	measure 'Promedio Reviews' =
			AVERAGEX(
			    SUMMARIZE(
			        FILTER('df_nuevas_columnas', NOT ISBLANK('df_nuevas_columnas'[review_score_entero])),
			        'df_nuevas_columnas'[order_id],
			        'df_nuevas_columnas'[review_score_entero]
			    ),
			    'df_nuevas_columnas'[review_score_entero]
			)
		formatString: 0.00
		lineageTag: d4f33a87-1b4a-41a6-9b5a-0e955617f651

	measure Total_Compras = ```
			
			CALCULATE(
			    DISTINCTCOUNT('df_nuevas_columnas'[order_id]),
			    ALLEXCEPT('df_nuevas_columnas', 'df_nuevas_columnas'[customer_unique_id])
			)
			
			```
		formatString: 0
		lineageTag: 4c376bd9-8c88-4542-87d4-842d19309c67

	measure Pedidos_Promedio_Cliente = ```
			
			VAR PedidosPorCliente = 
			    AVERAGEX(
			        VALUES('df_nuevas_columnas'[customer_unique_id]), 
			        CALCULATE(DISTINCTCOUNT('df_nuevas_columnas'[order_id]))
			    )
			RETURN PedidosPorCliente
			```
		lineageTag: e7f17c3c-96e0-4b63-a5e6-ceea06582391

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tiempo_Promedio_Entre_Compras = ```
			
			VAR ComprasClientes = 
			    ADDCOLUMNS(
			        'df_nuevas_columnas',
			        "FechaCompraAnterior",
			        VAR ClienteActual = 'df_nuevas_columnas'[customer_unique_id]
			        VAR FechaActual = 'df_nuevas_columnas'[order_purchase_timestamp]
			        RETURN 
			            MAXX(
			                FILTER(
			                    'df_nuevas_columnas', 
			                    'df_nuevas_columnas'[customer_unique_id] = ClienteActual &&
			                    'df_nuevas_columnas'[order_purchase_timestamp] < FechaActual
			                ), 
			                'df_nuevas_columnas'[order_purchase_timestamp]
			            )
			    )
			
			VAR DiferenciasDias = 
			    ADDCOLUMNS(
			        ComprasClientes,
			        "DiferenciaDias",
			        DATEDIFF([FechaCompraAnterior], [order_purchase_timestamp], DAY)
			    )
			
			VAR Promedio = 
			    AVERAGEX(
			        FILTER(DiferenciasDias, NOT(ISBLANK([DiferenciaDias]))), 
			        [DiferenciaDias]
			    )
			
			RETURN Promedio
			```
		lineageTag: 53efb5d7-51af-4460-8238-6a5f8ff98634

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Clientes = DISTINCTCOUNT('df_nuevas_columnas'[customer_unique_id])
		formatString: 0
		lineageTag: 3ce4a22e-4049-4ef2-8841-0eff07a65cc0

	measure Clientes_Recurrentes = ```
			
			VAR ClientesConMasDeUnPedido = 
			    FILTER(
			        VALUES('df_nuevas_columnas'[customer_unique_id]), 
			        CALCULATE(DISTINCTCOUNT('df_nuevas_columnas'[order_id])) > 1
			    )
			RETURN COUNTROWS(ClientesConMasDeUnPedido)
			```
		formatString: 0
		lineageTag: 12d8aac4-8b01-4d28-b6bb-16720ea7c0d7

	measure Tasa_Clientes_Recurrentes =
			
			DIVIDE([Clientes_Recurrentes], [Total_Clientes]) * 100
		lineageTag: 32f8d502-06bc-40e2-8f0f-94c47514ff91

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Tasa_Clientes_Unicos =
			
			(1 - DIVIDE([Clientes_Recurrentes], [Total_Clientes])) * 100
		lineageTag: 37564010-c1b7-4441-8206-4e6cadc48633

		annotation PBI_FormatHint = {"isGeneralNumber":true}

