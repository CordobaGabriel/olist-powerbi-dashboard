	column 'Score Valor Producto'
		dataType: int64
		formatString: 0
		lineageTag: 90415b46-de94-420d-9687-d07f2eab1ae1
		summarizeBy: none
		sourceColumn: score_valor_producto

		annotation SummarizationSetBy = Automatic

	column 'Score Total Categoría'
		dataType: int64
		formatString: 0
		lineageTag: cd74539e-deba-4f17-a6bd-b8ab5ea46db1
		summarizeBy: none
		sourceColumn: total_score_categoria

		annotation SummarizationSetBy = Automatic

	column 'Orden Categoría Precio' = SWITCH( TRUE(), Items[Precio] < 50, 1, Items[Precio] < 200, 2, 3 )
		isHidden
		lineageTag: 593c693f-4e45-495e-9a56-c9ace9acb313
		summarizeBy: none

	column 'Categoría Precio' = SWITCH( Items[Orden Categoría Precio], 1, "Económico (< R$ 50)", 2, "Medio (R$ 50-200)", "Premium (≥ R$ 200)" )
		lineageTag: 4cfad9f8-195c-4034-a648-d9f46156ca4c
		sortByColumn: 'Orden Categoría Precio'

	column 'Orden Costo Envío' =
			VAR Q1 = PERCENTILE.INC( Items[Costo Envío], 0.25 )
			VAR Q3 = PERCENTILE.INC( Items[Costo Envío], 0.75 )
			RETURN
			    SWITCH( TRUE(), Items[Costo Envío] <= Q1, 1, Items[Costo Envío] <= Q3, 2, 3 )
		isHidden
		lineageTag: 7336b478-3c22-48bd-a01d-41cf60c79999
		summarizeBy: none

	/// Cuartiles del costo de envío por ítem: ≤ Q1 barato, Q1-Q3 medio, > Q3 caro.
	column 'Categoría Costo Envío' = SWITCH( Items[Orden Costo Envío], 1, "Envío barato", 2, "Costo medio", "Envío caro" )
		lineageTag: 84b5c1a7-3475-44a3-949e-a7d81c8f9e4a
		sortByColumn: 'Orden Costo Envío'

	partition Items = m
		mode: import
		source =
				// Items: una fila por ítem de pedido (109.796). Fuente de ventas (precio + flete) por producto/seller.
				let
				    Origen = Olist_Base,
				    Columnas = Table.SelectColumns(
				        Origen,
				        {
				            "order_id", "order_item_id", "product_id", "seller_id", "shipping_limit_date",
				            "price", "freight_value", "rango_precio_producto", "score_valor_producto", "total_score_categoria"
				        }
				    ),
				    Unicos = Table.Distinct(Columnas, {"order_id", "order_item_id"})
				in
				    Unicos

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

