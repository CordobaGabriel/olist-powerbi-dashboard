/// Tabla contenedora de todas las medidas del modelo.
table Medidas
	lineageTag: 7cf30769-5888-4f60-a4f6-c2098444347a

	/// Precio + costo de envío de cada ítem vendido. Coincide con el total pagado (diferencia < 0,02 %).
	measure Ventas = SUMX( Items, Items[Precio] + Items[Costo Envío] )
		formatString: R$ #,0
		displayFolder: 1. Ventas
		lineageTag: 8b625f33-de68-4509-bcc8-81ddc073e125

	/// Ventas sin costo de envío.
	measure 'Ingresos Productos' = SUM( Items[Precio] )
		formatString: R$ #,0
		displayFolder: 1. Ventas
		lineageTag: aa3acbeb-266f-4f68-8ecc-a00a686df3f0

	measure 'Costo Envío Total' = SUM( Items[Costo Envío] )
		formatString: R$ #,0
		displayFolder: 1. Ventas
		lineageTag: 2f2e8799-4169-4a82-a27b-d57c82a9eba0

	/// Ventas promedio por pedido.
	measure 'Ticket Medio' = DIVIDE( [Ventas], [Cantidad Pedidos] )
		formatString: R$ #,0.00
		displayFolder: 1. Ventas
		lineageTag: 076cabb1-ad75-4d1a-8bd1-e29f1c03fc6a

	/// Participación sobre el total visible con los slicers aplicados.
	measure '% Participación Ventas' = DIVIDE( [Ventas], CALCULATE( [Ventas], ALLSELECTED() ) )
		formatString: 0.00%
		displayFolder: 1. Ventas
		lineageTag: 3f07c0f6-7283-4ed2-8d31-68c3b983b1ee

	/// Suma de pagos. Usar para análisis por método de pago.
	measure 'Monto Pagado' = SUM( Pagos[Monto Pago] )
		formatString: R$ #,0
		displayFolder: 1. Ventas
		lineageTag: e3a70715-aca7-4181-9962-a66b5eae92ef

	measure 'Cantidad Pedidos' = COUNTROWS( Pedidos )
		formatString: #,0
		displayFolder: 2. Pedidos
		lineageTag: 9a73f79c-e8ef-4c6f-acd2-7850016a9cb9

	measure 'Cantidad Ítems' = COUNTROWS( Items )
		formatString: #,0
		displayFolder: 2. Pedidos
		lineageTag: 9cdec2bf-dfef-4f1e-94ff-6ef948667266

	measure 'Cantidad Pagos' = COUNTROWS( Pagos )
		formatString: #,0
		displayFolder: 2. Pedidos
		lineageTag: 5d53f38d-c71c-4b88-abf0-864ea671ae8a

	/// Participación de pedidos sobre el total visible con los slicers aplicados.
	measure '% Pedidos' = DIVIDE( [Cantidad Pedidos], CALCULATE( [Cantidad Pedidos], ALLSELECTED() ) )
		formatString: 0.00%
		displayFolder: 2. Pedidos
		lineageTag: 2b5c7f48-522e-4d75-9787-44a5e71cbd17

	/// Clientes con al menos un pedido en el contexto actual.
	measure 'Cantidad Clientes' = DISTINCTCOUNT( Pedidos[ID Cliente] )
		formatString: #,0
		displayFolder: 3. Clientes
		lineageTag: 456a0ef4-7630-487e-8893-fd4c584331cb

	/// Clientes con más de un pedido en el contexto actual.
	measure 'Clientes Recurrentes' =
			COUNTROWS(
			    FILTER(
			        VALUES( Pedidos[ID Cliente] ),
			        CALCULATE( COUNTROWS( Pedidos ) ) > 1
			    )
			)
		formatString: #,0
		displayFolder: 3. Clientes
		lineageTag: 33437dc8-d674-46e8-8ea7-3e248a5e7e80

	measure '% Clientes Recurrentes' = DIVIDE( [Clientes Recurrentes], [Cantidad Clientes] )
		formatString: 0.0%
		displayFolder: 3. Clientes
		lineageTag: 64d2169b-301a-482e-9e0b-49b6be6ed7d4

	/// Pedidos entregados después del día estimado / pedidos entregados.
	measure '% Entregas con Retraso' =
			DIVIDE(
			    CALCULATE( COUNTROWS( Pedidos ), KEEPFILTERS( Pedidos[Días Retraso Entrega] > 0 ) ),
			    CALCULATE( COUNTROWS( Pedidos ), KEEPFILTERS( NOT ISBLANK( Pedidos[Fecha Entrega] ) ) )
			)
		formatString: 0.0%
		displayFolder: 4. Logística
		lineageTag: e5c7073d-ce6b-4cce-b7ce-49e0b10c4a9d

	/// Días promedio entre compra y entrega.
	measure 'Días Entrega Promedio' =
			AVERAGEX(
			    FILTER( Pedidos, NOT ISBLANK( Pedidos[Fecha Entrega] ) ),
			    DATEDIFF( Pedidos[Fecha Hora Compra], Pedidos[Fecha Entrega], DAY )
			)
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: 4485cdab-8b05-4efd-9b87-a3a352998d35

	/// Días promedio entre compra y fecha estimada de entrega.
	measure 'Días Entrega Estimados Promedio' =
			AVERAGEX(
			    FILTER( Pedidos, NOT ISBLANK( Pedidos[Fecha Entrega Estimada] ) ),
			    DATEDIFF( Pedidos[Fecha Hora Compra], Pedidos[Fecha Entrega Estimada], DAY )
			)
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: a091d123-0c6f-448c-bc8c-19813b444880

	/// Promedio de (entrega - estimada). Negativo = en promedio llega antes de lo estimado.
	measure 'Días Retraso Promedio' = AVERAGE( Pedidos[Días Retraso Entrega] )
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: f000497a-daa9-4aef-b3f2-3f7ab08ee95f

	/// Costo de envío promedio por ítem.
	measure 'Costo Envío Promedio' = AVERAGE( Items[Costo Envío] )
		formatString: R$ #,0.00
		displayFolder: 4. Logística
		lineageTag: ed26d903-e2a3-424e-996e-24f89081dfe9

	/// Pedidos con reseña.
	measure 'Cantidad Reseñas' = CALCULATE( COUNTROWS( Pedidos ), KEEPFILTERS( NOT ISBLANK( Pedidos[Puntaje Reseña] ) ) )
		formatString: #,0
		displayFolder: 5. Reseñas
		lineageTag: 7cfb5023-73d9-4c8e-856f-2bd6d4da32ae

	/// Puntaje promedio de reseñas (1 a 5).
	measure 'Puntaje Promedio' = AVERAGE( Pedidos[Puntaje Reseña] )
		formatString: 0.00
		displayFolder: 5. Reseñas
		lineageTag: d4476fb1-938d-4ee3-a4e5-d3f2bf9d401d

	/// Reseñas con puntaje 4 o 5 / total de reseñas.
	measure '% Reseñas Positivas (4-5)' =
			DIVIDE(
			    CALCULATE( [Cantidad Reseñas], KEEPFILTERS( Pedidos[Puntaje Reseña] >= 4 ) ),
			    [Cantidad Reseñas]
			)
		formatString: 0.0%
		displayFolder: 5. Reseñas
		lineageTag: 4676cb61-b618-456b-9de8-6a0a09825f37

	/// Barra SVG con la participación en ventas, escalada contra la categoría más grande. Para usar en tablas por macro categoría.
	measure 'SVG Participación Ventas' =
			VAR Pct = [% Participación Ventas]
			VAR MaxPct = MAXX( ALLSELECTED( Productos[Macro Categoría] ), [% Participación Ventas] )
			VAR Ancho = ROUND( DIVIDE( Pct, MaxPct ) * 110, 0 )
			VAR Texto = SUBSTITUTE( FORMAT( Pct, "0.0%" ), "%", "%25" )
			RETURN
			    IF(
			        ISINSCOPE( Productos[Macro Categoría] ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='170' height='20'>"
			            & "<rect x='0' y='6' width='110' height='8' rx='4' fill='%231F2B4D'/>"
			            & "<rect x='0' y='6' width='" & Ancho & "' height='8' rx='4' fill='%233B78F0'/>"
			            & "<text x='118' y='14' font-family='Segoe UI' font-size='11' fill='%23E6EAF2'>" & Texto & "</text></svg>"
			    )
		displayFolder: 6. Visuales SVG
		lineageTag: dc2cc121-508b-49b2-a4f4-efbc1e5e13e7
		dataCategory: ImageUrl

	/// Cinco estrellas SVG rellenas según el puntaje promedio de reseñas.
	measure 'SVG Puntaje Estrellas' =
			VAR Puntaje = [Puntaje Promedio]
			VAR Ancho = ROUND( DIVIDE( Puntaje, 5 ) * 84, 0 )
			VAR Fila =
			    "<use xlink:href='%23e'/><use xlink:href='%23e' x='17'/><use xlink:href='%23e' x='34'/>"
			        & "<use xlink:href='%23e' x='51'/><use xlink:href='%23e' x='68'/>"
			RETURN
			    IF(
			        NOT ISBLANK( Puntaje ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' width='130' height='18'>"
			            & "<defs><polygon id='e' points='8,1 10,6 15.5,6 11,9.5 12.8,15 8,11.8 3.2,15 5,9.5 0.5,6 6,6'/>"
			            & "<clipPath id='c'><rect width='" & Ancho & "' height='18'/></clipPath></defs>"
			            & "<g fill='%232A3658'>" & Fila & "</g>"
			            & "<g fill='%23F5B83D' clip-path='url(%23c)'>" & Fila & "</g>"
			            & "<text x='90' y='13' font-family='Segoe UI' font-size='11' fill='%23E6EAF2'>" & FORMAT( Puntaje, "0.00" ) & "</text></svg>"
			    )
		displayFolder: 6. Visuales SVG
		lineageTag: 484b5821-636e-401e-99a3-989e6541998d
		dataCategory: ImageUrl

	/// Última fecha con pedidos en todo el modelo. Corta las comparaciones y separa real de proyección.
	measure 'Última Fecha Datos' = CALCULATE( MAX( Pedidos[Fecha Compra] ), REMOVEFILTERS() )
		formatString: dd/mm/yyyy
		isHidden
		displayFolder: 0. Auxiliares
		lineageTag: b1e0248b-0f4c-49d0-9efa-0b57830922cd

	/// SUPUESTO: precio × % de costo por macro categoría (tabla 'Supuestos Costos').
	measure 'Costo Mercadería' = SUM( Items[Costo Mercadería] )
		formatString: R$ #,0
		displayFolder: 7. Rentabilidad
		lineageTag: 6126fa9d-80fd-413d-b7ad-377c69b527cd

	/// SUPUESTO: 3 % de las ventas cobrado por procesadores de pago.
	measure 'Comisión Medios de Pago' = [Ventas] * 0.03
		formatString: R$ #,0
		displayFolder: 7. Rentabilidad
		lineageTag: 96622d57-0b1e-4652-a1f1-e7aa308961f5

	/// Ingresos por productos - costo de mercadería - comisión de medios de pago. El flete se toma como traslado (lo que se cobra se paga al transportista).
	measure 'Margen Contribución' = [Ingresos Productos] - [Costo Mercadería] - [Comisión Medios de Pago]
		formatString: R$ #,0
		displayFolder: 7. Rentabilidad
		lineageTag: d78db7c9-bc45-4389-a644-caffa1d031d2

	/// Margen de contribución sobre ingresos por productos.
	measure '% Margen Contribución' = DIVIDE( [Margen Contribución], [Ingresos Productos] )
		formatString: 0.0%
		displayFolder: 7. Rentabilidad
		lineageTag: 758abc34-1e8b-4f60-aab9-3c8611b8cd36

	measure 'Ventas por Cliente' = DIVIDE( [Ventas], [Cantidad Clientes] )
		formatString: R$ #,0.00
		displayFolder: 3. Clientes
		lineageTag: cedc64bc-7098-42eb-a3f8-27f716bc31d9

	measure 'Margen por Cliente' = DIVIDE( [Margen Contribución], [Cantidad Clientes] )
		formatString: R$ #,0.00
		displayFolder: 3. Clientes
		lineageTag: 30c79590-e5f3-4792-b989-badfb6857e8b

	/// Pareto: margen acumulado de las categorías con margen mayor o igual a la actual, sobre el total.
	measure '% Acumulado Margen' =
			VAR MargenActual = [Margen Contribución]
			VAR Total = CALCULATE( [Margen Contribución], ALLSELECTED( Productos[Categoría] ) )
			VAR Acumulado =
			    SUMX(
			        FILTER( ALLSELECTED( Productos[Categoría] ), [Margen Contribución] >= MargenActual ),
			        [Margen Contribución]
			    )
			RETURN
			    IF( ISINSCOPE( Productos[Categoría] ), DIVIDE( Acumulado, Total ) )
		formatString: 0.0%
		displayFolder: 7. Rentabilidad
		lineageTag: 0a581294-7507-40af-81f5-c2b54eec8a5e

	/// A = categorías que suman el primer 80 % del margen; B = hasta 95 %; C = el resto.
	measure 'Clase ABC' =
			VAR Acum = [% Acumulado Margen]
			RETURN
			    IF( NOT ISBLANK( Acum ), SWITCH( TRUE(), Acum <= 0.8, "A", Acum <= 0.95, "B", "C" ) )
		displayFolder: 7. Rentabilidad
		lineageTag: a60bcf4a-2233-4dea-9372-e75df26c0951

	/// Cantidad mínima de categorías que generan el 80 % del margen de contribución.
	measure 'Categorías 80% Margen' =
			VAR Tabla = ADDCOLUMNS( VALUES( Productos[Categoría] ), "@Margen", [Margen Contribución] )
			VAR Total = SUMX( Tabla, [@Margen] )
			VAR ConAcumulado =
			    ADDCOLUMNS(
			        Tabla,
			        "@Previo", VAR M = [@Margen] RETURN SUMX( FILTER( Tabla, [@Margen] > M ), [@Margen] )
			    )
			RETURN
			    COUNTROWS( FILTER( ConAcumulado, [@Previo] < 0.8 * Total ) )
		formatString: 0
		displayFolder: 7. Rentabilidad
		lineageTag: 89963682-2b60-465e-98bf-1515f7be1cc2

	measure 'Cantidad Categorías' = COUNTROWS( FILTER( VALUES( Productos[Categoría] ), NOT ISBLANK( [Ventas] ) ) )
		formatString: 0
		displayFolder: 7. Rentabilidad
		lineageTag: 885b95ea-df41-46a2-ba22-03d8b216abd4

	/// Ej.: '17 de 64 categorías' generan el 80 % del margen.
	measure 'Texto Pareto' = [Categorías 80% Margen] & " de " & [Cantidad Categorías] & " categorías"
		displayFolder: 7. Rentabilidad
		lineageTag: d93c97eb-ec18-41fe-b887-172d5b385151

	/// SUPUESTO: crecimiento objetivo sobre el año anterior (120 % por defecto; se cambia con el parámetro).
	measure 'Valor Crecimiento Objetivo' = SELECTEDVALUE( 'Crecimiento Objetivo'[Crecimiento Objetivo], 1.2 )
		formatString: 0%
		displayFolder: 9. Metas y Proyección
		lineageTag: 64830fac-142c-4652-b616-d2cebe2f0a4b

	/// Ventas del mismo período del año anterior, cortado en la última fecha con datos.
	measure 'Ventas AA' =
			VAR UltimaFecha = [Última Fecha Datos]
			RETURN
			    CALCULATE(
			        [Ventas],
			        SAMEPERIODLASTYEAR( FILTER( VALUES( Calendario[Fecha] ), Calendario[Fecha] <= UltimaFecha ) )
			    )
		formatString: R$ #,0
		displayFolder: 8. Comparaciones
		lineageTag: a3d4a03f-a171-40f0-8832-5d47930dcbb2

	/// Meta = ventas del mismo período del año anterior × (1 + crecimiento objetivo). Cortada en la última fecha con datos.
	measure 'Meta Ventas' = [Ventas AA] * ( 1 + [Valor Crecimiento Objetivo] )
		formatString: R$ #,0
		displayFolder: 9. Metas y Proyección
		lineageTag: eda2e4dc-8059-4219-a367-44a78cc26ddf

	/// Meta del período completo (incluye meses sin datos todavía). Para el plan anual.
	measure 'Meta Ventas Plan' = CALCULATE( [Ventas], SAMEPERIODLASTYEAR( Calendario[Fecha] ) ) * ( 1 + [Valor Crecimiento Objetivo] )
		formatString: R$ #,0
		displayFolder: 9. Metas y Proyección
		lineageTag: 48aa3128-a280-447e-a567-d63c8ff6dfb9

	measure 'Cumplimiento Meta' = DIVIDE( [Ventas], [Meta Ventas] )
		formatString: 0%
		displayFolder: 9. Metas y Proyección
		lineageTag: d28ff246-0040-4bb8-89f6-25ffa14d0978

	/// Meses futuros: promedio de los últimos 3 meses completos. En el último mes real repite el valor real para que la línea empalme.
	measure 'Ventas Proyectadas' =
			VAR UltimaFecha = [Última Fecha Datos]
			VAR MesUltimo = YEAR( UltimaFecha ) * 100 + MONTH( UltimaFecha )
			VAR Base =
			    CALCULATE(
			        [Ventas],
			        DATESINPERIOD( Calendario[Fecha], EOMONTH( UltimaFecha, -1 ), -3, MONTH ),
			        REMOVEFILTERS( Calendario )
			    ) / 3
			VAR MesesFuturos = FILTER( VALUES( Calendario[Año Mes Num] ), Calendario[Año Mes Num] > MesUltimo )
			VAR Proyeccion = SUMX( MesesFuturos, Base )
			VAR Empalme =
			    IF( HASONEVALUE( Calendario[Año Mes Num] ) && VALUES( Calendario[Año Mes Num] ) = MesUltimo, [Ventas] )
			RETURN
			    IF( COUNTROWS( MesesFuturos ) > 0, Proyeccion, Empalme )
		formatString: R$ #,0
		displayFolder: 9. Metas y Proyección
		lineageTag: b126ecc8-e054-45ca-a7a9-3eef1fbf9f19

	/// Ventas reales del período + proyección de los meses que faltan.
	measure 'Proyección Cierre Año' =
			VAR UltimaFecha = [Última Fecha Datos]
			VAR MesUltimo = YEAR( UltimaFecha ) * 100 + MONTH( UltimaFecha )
			VAR Base =
			    CALCULATE(
			        [Ventas],
			        DATESINPERIOD( Calendario[Fecha], EOMONTH( UltimaFecha, -1 ), -3, MONTH ),
			        REMOVEFILTERS( Calendario )
			    ) / 3
			VAR MesesFuturos = FILTER( VALUES( Calendario[Año Mes Num] ), Calendario[Año Mes Num] > MesUltimo )
			RETURN
			    [Ventas] + COUNTROWS( MesesFuturos ) * Base
		formatString: R$ #,0
		displayFolder: 9. Metas y Proyección
		lineageTag: 3d4ddd6c-3370-49bd-ad46-9faa5e59154f

	measure 'Cumplimiento Proyectado' = DIVIDE( [Proyección Cierre Año], [Meta Ventas Plan] )
		formatString: 0%
		displayFolder: 9. Metas y Proyección
		lineageTag: 175757b6-fc17-412e-9c68-01163179f812

	measure 'Brecha Proyectada vs Meta' = [Proyección Cierre Año] - [Meta Ventas Plan]
		formatString: R$ #,0
		displayFolder: 9. Metas y Proyección
		lineageTag: 01817eda-7a56-49d1-b1fd-07f6c52a641c

	/// Días promedio entre la aprobación del pago y la entrega al transportista (responsabilidad del vendedor).
	measure 'Días Despacho Vendedor' =
			AVERAGEX(
			    FILTER( Pedidos, NOT ISBLANK( Pedidos[Fecha Aprobación] ) && NOT ISBLANK( Pedidos[Fecha Despacho] ) ),
			    DATEDIFF( Pedidos[Fecha Aprobación], Pedidos[Fecha Despacho], DAY )
			)
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: d96bbd1d-0c76-43aa-b530-5a20e8129c24

	/// Días promedio entre el despacho y la entrega al cliente (responsabilidad del transportista).
	measure 'Días Tránsito' =
			AVERAGEX(
			    FILTER( Pedidos, NOT ISBLANK( Pedidos[Fecha Despacho] ) && NOT ISBLANK( Pedidos[Fecha Entrega] ) ),
			    DATEDIFF( Pedidos[Fecha Despacho], Pedidos[Fecha Entrega], DAY )
			)
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: 73c01655-d76b-44b9-8ffa-3cae75a87e4f

	measure 'Pedidos con Retraso' = CALCULATE( COUNTROWS( Pedidos ), KEEPFILTERS( Pedidos[Estado Entrega] = "Tardío" ) )
		formatString: #,0
		displayFolder: 4. Logística
		lineageTag: 813f11d8-cc33-4b4f-9826-954d1f9c234b

	/// Pedidos tardíos en los que el vendedor despachó fuera de plazo.
	measure 'Retrasos por Despacho' = CALCULATE( [Pedidos con Retraso], KEEPFILTERS( Items[Despacho Tardío] = TRUE() ) )
		formatString: #,0
		displayFolder: 4. Logística
		lineageTag: bd1bfdd3-43d8-4eee-8e0b-97e0b3db92b5

	/// Pedidos tardíos despachados en plazo: el retraso se produjo en el tránsito.
	measure 'Retrasos por Tránsito' = VAR Tarde = [Pedidos con Retraso] RETURN IF( NOT ISBLANK( Tarde ), Tarde - [Retrasos por Despacho] )
		formatString: #,0
		displayFolder: 4. Logística
		lineageTag: f3562913-aba7-4c0b-a5bb-b79cb51ffcbf

	measure '% Retrasos por Despacho' = DIVIDE( [Retrasos por Despacho], [Pedidos con Retraso] )
		formatString: 0%
		displayFolder: 4. Logística
		lineageTag: e9292b55-7e8b-4bde-962c-c1c0b0066ad8

	measure '% Despacho Fuera de Plazo' = DIVIDE( CALCULATE( COUNTROWS( Pedidos ), KEEPFILTERS( Items[Despacho Tardío] = TRUE() ) ), [Cantidad Pedidos] )
		formatString: 0.0%
		displayFolder: 4. Logística
		lineageTag: 773d739a-89c1-4d15-83a0-a58b97921fd7

	measure 'Costo Envío % Ventas' = DIVIDE( [Costo Envío Total], [Ventas] )
		formatString: 0.0%
		displayFolder: 4. Logística
		lineageTag: 92450d54-abbf-40dc-963c-98d7d5d7a376

	/// Solo vendedores con 50 pedidos o más (muestra representativa).
	measure 'Pedidos Vendedor' = IF( [Cantidad Pedidos] >= 50, [Cantidad Pedidos] )
		formatString: #,0
		displayFolder: 4. Logística
		lineageTag: 960366e4-3e92-429a-bba4-3d9ee286c67e

	measure '% Retraso Vendedor' = IF( [Cantidad Pedidos] >= 50, [% Entregas con Retraso] )
		formatString: 0.0%
		displayFolder: 4. Logística
		lineageTag: ba03e5c4-b861-4811-840f-e6d71530849d

	measure 'Días Despacho Vendedor (≥50)' = IF( [Cantidad Pedidos] >= 50, [Días Despacho Vendedor] )
		formatString: 0.0
		displayFolder: 4. Logística
		lineageTag: f3a9c83d-4dc1-4804-a815-e838f5e4f283

	/// Clientes cuya primera compra cae en el período.
	measure 'Clientes Nuevos' =
			VAR Desde = MIN( Calendario[Fecha] )
			VAR Hasta = MAX( Calendario[Fecha] )
			RETURN
			    COUNTROWS( FILTER( Clientes, Clientes[Fecha Primera Compra] >= Desde && Clientes[Fecha Primera Compra] <= Hasta ) )
		formatString: #,0
		displayFolder: 3. Clientes
		lineageTag: 9a77eba4-3f2e-40e0-a9fe-03fc5f2737c5

	measure 'Valor Reducción Retrasos' = SELECTEDVALUE( 'Reducción Retrasos'[Reducción Retrasos], 0.5 )
		formatString: 0%
		displayFolder: 10. Escenarios
		lineageTag: a45ec735-db2a-4103-99b0-49c2aafc2227

	measure 'Puntaje A Tiempo' = CALCULATE( [Puntaje Promedio], KEEPFILTERS( Pedidos[Estado Entrega] = "A Tiempo" ) )
		formatString: 0.00
		displayFolder: 10. Escenarios
		lineageTag: 34fb30fd-6743-4847-881e-2d0efb031b7b

	measure 'Puntaje Tardío' = CALCULATE( [Puntaje Promedio], KEEPFILTERS( Pedidos[Estado Entrega] = "Tardío" ) )
		formatString: 0.00
		displayFolder: 10. Escenarios
		lineageTag: aa2ba7c9-767b-4869-966c-2845cbd193d2

	/// Puntaje estimado si la fracción elegida de entregas tardías llegara a tiempo y puntuara como las entregas a tiempo.
	measure 'Puntaje Escenario' =
			VAR ResenasTarde = CALCULATE( [Cantidad Reseñas], KEEPFILTERS( Pedidos[Estado Entrega] = "Tardío" ) )
			RETURN
			    [Puntaje Promedio]
			        + DIVIDE( ResenasTarde * [Valor Reducción Retrasos] * ( [Puntaje A Tiempo] - [Puntaje Tardío] ), [Cantidad Reseñas] )
		formatString: 0.00
		displayFolder: 10. Escenarios
		lineageTag: 7e97a474-95c7-4eac-9aa1-38ebda016df8

	measure '% Retraso Escenario' = [% Entregas con Retraso] * ( 1 - [Valor Reducción Retrasos] )
		formatString: 0.0%
		displayFolder: 10. Escenarios
		lineageTag: 9c5761b6-1668-4200-9da0-33bc07cb7841

	measure 'Mejora Puntaje Escenario' = [Puntaje Escenario] - [Puntaje Promedio]
		formatString: +0.00;-0.00;0.00
		displayFolder: 10. Escenarios
		lineageTag: 1429f467-1a0d-4d12-a7e0-a23fa1d9dc1f

	measure 'Δ Ventas Flecha' =
			VAR Actual = [Ventas]
			VAR Anterior = [Ventas AA]
			VAR Delta = DIVIDE( Actual - Anterior, Anterior )
			RETURN
			    IF(
			        ISBLANK( Actual ) || ISBLANK( Anterior ),
			        "●",
			        IF( Delta > 0, "▲", IF( Delta < 0, "▼", "●" ) )
			    )
		displayFolder: 8. Comparaciones

	measure 'Δ Ventas Texto' =
			VAR Actual = [Ventas]
			VAR Anterior = [Ventas AA]
			VAR Delta = DIVIDE( Actual - Anterior, Anterior )
			RETURN
			    IF(
			        ISBLANK( Actual ) || ISBLANK( Anterior ),
			        "sin dato del año anterior",
			        FORMAT( ABS( Delta ), "0.0%" ) & " vs. año anterior"
			    )
		displayFolder: 8. Comparaciones

	measure 'Δ Ventas Color' =
			VAR Actual = [Ventas]
			VAR Anterior = [Ventas AA]
			VAR Delta = DIVIDE( Actual - Anterior, Anterior )
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( Actual ) || ISBLANK( Anterior ), "#8A96B3",
			        Delta > 0, "#0CA30C",
			        Delta < 0, "#EC835A",
			        "#8A96B3"
			    )
		isHidden
		displayFolder: 8. Comparaciones

