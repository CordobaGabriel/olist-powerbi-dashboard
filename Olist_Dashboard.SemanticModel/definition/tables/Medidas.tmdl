	measure 'Δ Días Despacho Vendedor Flecha' =
			VAR Actual = [Días Despacho Vendedor]
			VAR Anterior = [Días Despacho Vendedor AA]
			VAR Delta = Actual - Anterior
			RETURN
			    IF(
			        ISBLANK( Actual ) || ISBLANK( Anterior ),
			        "●",
			        IF( Delta > 0, "▲", IF( Delta < 0, "▼", "●" ) )
			    )
		displayFolder: 8. Comparaciones

	measure 'Δ Días Despacho Vendedor Texto' =
			VAR Actual = [Días Despacho Vendedor]
			VAR Anterior = [Días Despacho Vendedor AA]
			VAR Delta = Actual - Anterior
			RETURN
			    IF(
			        ISBLANK( Actual ) || ISBLANK( Anterior ),
			        "sin dato del año anterior",
			        FORMAT( ABS( Delta ), "0.0" ) & " días" & " vs. año anterior"
			    )
		displayFolder: 8. Comparaciones

	measure 'Δ Días Despacho Vendedor Color' =
			VAR Actual = [Días Despacho Vendedor]
			VAR Anterior = [Días Despacho Vendedor AA]
			VAR Delta = Actual - Anterior
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( Actual ) || ISBLANK( Anterior ), "#8A96B3",
			        Delta < 0, "#0CA30C",
			        Delta > 0, "#EC835A",
			        "#8A96B3"
			    )
		isHidden
		displayFolder: 8. Comparaciones

	/// Días Tránsito del mismo período del año anterior, cortado en la última fecha con datos.
	measure 'Días Tránsito AA' =
			VAR UltimaFecha = [Última Fecha Datos]
			RETURN
			    CALCULATE(
			        [Días Tránsito],
			        SAMEPERIODLASTYEAR( FILTER( VALUES( Calendario[Fecha] ), Calendario[Fecha] <= UltimaFecha ) )
			    )
		formatString: 0.0
		displayFolder: 8. Comparaciones

