model Model
	culture: es-AR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["df_olist_actualizado_dataset","Errores en df_olist_actualizado_dataset","Errores en df_olist_actualizado_dataset (2)","Errores en df_olist_actualizado_dataset (3)","Errores en df_olist_actualizado_dataset (4)","df_nuevas_columnas","RutaCSV","Olist_Base","Pedidos","Items","Pagos","Clientes","Productos","Vendedores"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Pedidos
ref table Items
ref table Pagos
ref table Clientes
ref table Productos
ref table Vendedores
ref table Calendario
ref table Medidas
ref table 'Supuestos Costos'
ref table 'Crecimiento Objetivo'
ref table 'Reducción Retrasos'
ref table 'Primeras Compras'
ref table 'Meses de Vida'
ref table Recompras

ref cultureInfo es-AR

