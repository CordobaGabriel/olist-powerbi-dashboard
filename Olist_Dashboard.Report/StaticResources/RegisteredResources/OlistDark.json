{
  "name": "Olist Dark",
  "dataColors": [
    "#3B78F0",
    "#D95926",
    "#199E70",
    "#C98500",
    "#9085E9",
    "#6DA7EC",
    "#E66767",
    "#48B98F",
    "#E0B04A",
    "#B3AAF0"
  ],
  "background": "#111B38",
  "foreground": "#E6EAF2",
  "tableAccent": "#3B78F0",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#3B78F0",
  "center": "#5B6785",
  "minimum": "#16213F",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EAF2"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EAF2"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EAF2"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#8A96B3"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "fontSize": 9
          }
        ],
        "visualTooltip": [
          {
            "background": {
              "solid": {
                "color": "#0D1631"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            },
            "showAxisTitle": false
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#B4BDD3"
              }
            },
            "position": "TopLeft"
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#B4BDD3"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#0D1631"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            }
          }
        ],
        "filterCard": [
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#111B38"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            }
          },
          {
            "$id": "Applied",
            "backgroundColor": {
              "solid": {
                "color": "#16213F"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1128"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "background": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A96B3"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#1F2B4D"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111B38"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8A96B3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#B4BDD3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111B38"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111B38"
              }
            }
          }
        ]
      }
    }
  }
}